{
  "name": "dsh-prompt-picker",
  "version": "0.10.0",
  "description": "Prompt picker for DeepSeek Harness: multi-select system-prompt injections with per-row scopes (both/main/sub), a unified New/Edit dialog with in-dialog delete (every row deletable, built-in included), and one-click uncheck-all.",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solopole/dsh-prompt-picker.git"
  },
  "homepage": "https://github.com/solopole/dsh-prompt-picker#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs/*.png",
    "docs/*.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "icon": "./icon.svg"
}